{
    "name": "iis-blocks",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "build": "wp-scripts build --output-path=dist",
        "start": "wp-scripts start --output-path=dist",
        "dev": "npm run development",
        "development": "npm run start -- --no-watch",
        "watch": "npm run start",
        "watch-poll": "npm run start -- --watch-options-poll=1000",
        "prod": "npm run production",
        "production": "npm run build",
        "eslint": "eslint src",
        "wp-start": "wp-env start",
        "wp-stop": "wp-env stop"
    },
    "devDependencies": {
        "@internetstiftelsen/eslint-config-react": "^4.0.0",
        "@wordpress/env": "^10.1.0",
        "@wordpress/scripts": "^34.2.0",
        "eslint": "^9.14.0",
        "webpack-cli": "^5.1.4"
    }
}
