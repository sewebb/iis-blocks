{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "iis/visualization",
  "title": "Visualization",
  "category": "iis",
  "icon": "welcome-view-site",
  "keywords": [
    "visualization"
  ],
  "supports": {
    "align": [
      "right"
    ]
  },
  "attributes": {
