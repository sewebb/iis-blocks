{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "iis/testimonial",
    "title": "Testimonial",
    "category": "iis",
    "icon": "format-quote",
    "keywords": [
        "testimonial",
        "quote"
    ],
    "attributes": {
        "photoUrl": {
            "type": "string",
            "default": null
        },
        "photoId": {
            "type": "number",
            "default": null
        },
        "quote": {
            "type": "string",
            "default": ""
        },
        "name": {
            "type": "string",
            "default": ""
        }
    },
    "textdomain": "iis-blocks",
    "editorScript": "file:./index.js",
    "render": "file:./render.php"
}
